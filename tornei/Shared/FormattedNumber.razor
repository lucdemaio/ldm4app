@using System.Globalization
@typeparam TNumber
@if (Value is null)
{
    <span></span>
}
else
{
    <span>@FormatValue()</span>
}

@code {
    [Parameter]
    public TNumber? Value { get; set; }

    /// <summary>
    /// .NET format string to apply (default "F2").
    /// </summary>
    [Parameter]
    public string Format { get; set; } = "F2";

    /// <summary>
    /// Culture to use when formatting (default "it-IT").
    /// </summary>
    [Parameter]
    public string Culture { get; set; } = "it-IT";

    /// <summary>
    /// If true, the value is treated as a fraction (0.0-1.0) and displayed as percent (value*100 + "%").
    /// </summary>
    [Parameter]
    public bool AsPercent { get; set; } = false;

    private string FormatValue()
    {
        if (Value == null) return string.Empty;
        try
        {
            var ci = new CultureInfo(Culture);

            if (AsPercent)
            {
                // Attempt to convert to double and format multiplied by 100
                if (Value is IConvertible conv)
                {
                    var d = conv.ToDouble(System.Globalization.CultureInfo.InvariantCulture) * 100.0;
                    return d.ToString(Format, ci) + "%";
                }
            }

            // Use IFormattable when possible
            if (Value is IFormattable formattable)
                return formattable.ToString(Format, ci);

            return Value.ToString() ?? string.Empty;
        }
        catch
        {
            return Value.ToString() ?? string.Empty;
        }
    }
