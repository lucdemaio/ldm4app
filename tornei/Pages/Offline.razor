@page "/offline"
@inject IJSRuntime JS

<h3>Salvataggi offline (richieste fallite)</h3>

@if (loading)
{
    <p>Caricamento...</p>
}
else if (items == null || items.Count == 0)
{
    <p>Nessuna richiesta salvata.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Metodo</th>
                <th>URL</th>
                <th>Corpo</th>
                <th>Data</th>
                <th>Azioni</th>
            </tr>
        </thead>
        <tbody>
        @foreach(var it in items)
        {
            <tr>
                <td>@it.id</td>
                <td>@it.method</td>
                <td>@it.url</td>
                <td style="max-width:360px; white-space:pre-wrap; overflow-wrap:break-word;">@it.body</td>
                <td>@(new DateTime(1970,1,1).AddMilliseconds((long)it.timestamp).ToLocalTime())</td>
                <td>
                    <button class="btn btn-sm btn-primary me-1" @onclick="() => Replay(it.id)">Riproduci</button>
                    <button class="btn btn-sm btn-danger" @onclick="() => Delete(it.id)">Elimina</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <button class="btn btn-sm btn-success" @onclick="ReplayAll">Riproduci tutte</button>
    <button class="btn btn-sm btn-secondary ms-2" @onclick="Refresh">Aggiorna</button>
}

@code {
    bool loading = true;
    List<dynamic>? items;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
    }

    async Task Refresh()
    {
        loading = true;
        try
        {
            items = await JS.InvokeAsync<List<dynamic>>("__gtw_offline.list");
        }
        finally { loading = false; }
        StateHasChanged();
    }

    async Task Delete(long id)
    {
        await JS.InvokeVoidAsync("__gtw_offline.delete", id);
        await Refresh();
    }

    async Task Replay(long id)
    {
        var res = await JS.InvokeAsync<object>("__gtw_offline.replay", id);
        await Refresh();
        // small feedback - could be improved
        await JS.InvokeVoidAsync("console.log", res);
    }

    async Task ReplayAll()
    {
        var results = await JS.InvokeAsync<object>("__gtw_offline.replayAll");
        await Refresh();
        await JS.InvokeVoidAsync("console.log", results);
    }
}
