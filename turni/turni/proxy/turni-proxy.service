[Unit]
Description=Turni Gemini Proxy
After=network.target

[Service]
Type=simple
WorkingDirectory=/path/to/turni/proxy   # <-- REPLACE with actual path on server
ExecStart=/usr/bin/node server.js
Restart=always
Environment=NODE_ENV=production
Environment=GEMINI_KEY=your_gemini_key_here
Environment=ALLOWED_ORIGINS=https://www.ldm4app.com
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
